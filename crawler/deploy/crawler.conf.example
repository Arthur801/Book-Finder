# Non-secret configuration, sourced by root. Use a fixed release tag or image digest.
CRAWLER_IMAGE=YOUR_DOCKERHUB_USER/book-finder-crawler:2026-10-12.1
AWS_REGION=ap-northeast-1
# This parameter must contain a psycopg PostgreSQL URL, not a .NET connection string.
DATABASE_URL_PARAMETER=/book-finder/prod/crawler-database-url
