@model Book_Finder.Models.HomeViewModel
@{
    ViewData["Title"] = "首頁";
}

<section class="mb-5">
    <h1 class="h3 mb-3">找書</h1>

    <partial name="_SearchForm" model="string.Empty" />

    <form id="home-ai-form" method="get" action="/ai">
        <label for="ai-request" class="form-label">用一句話描述你想讀的書（AI 推薦）</label>
        <textarea id="ai-request" class="form-control mb-2" rows="2" placeholder="例：想學資料庫入門，最好有實作練習"></textarea>
        <button class="btn btn-outline-primary" type="submit">AI 推薦</button>
    </form>
</section>

<section>
    <div class="d-flex justify-content-between align-items-baseline mb-2">
        <h2 class="h4 mb-0">從書庫挑幾本</h2>
        <a href="/books">查看完整書庫</a>
    </div>
    @if (Model.IsEmpty)
    {
        <p class="text-muted">書庫還沒有書</p>
    }
    else
    {
        <partial name="_BookList" model="Model.Items" />
    }
</section>

@section Scripts {
    <script src="~/js/ai.js" asp-append-version="true"></script>
}
