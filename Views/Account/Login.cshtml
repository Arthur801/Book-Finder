@model Book_Finder.Models.LoginForm
@{
    ViewData["Title"] = "登入";
}

<section class="col-12 col-md-6 col-lg-4 mx-auto">
    <h1 class="h3 mb-3">登入</h1>

    <form method="post" asp-controller="Account" asp-action="Login">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

        <input type="hidden" asp-for="ReturnUrl" />
        <input type="hidden" asp-for="PendingAction" />

        <div class="mb-3">
            <label class="form-label" for="Email">Email</label>
            <input asp-for="Email" type="email" autocomplete="email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label class="form-label" for="Password">密碼</label>
            <input asp-for="Password" type="password" autocomplete="current-password" class="form-control" />
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>

        <button class="btn btn-primary" type="submit">登入</button>
    </form>

    <p class="mt-3 mb-0">
        還沒有帳號？<a asp-controller="Account" asp-action="Register"
                    asp-route-returnUrl="@Model.ReturnUrl" asp-route-pendingAction="@Model.PendingAction">註冊</a>
    </p>
</section>
