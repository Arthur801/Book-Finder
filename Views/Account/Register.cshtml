@model Book_Finder.Models.RegisterForm
@{
    ViewData["Title"] = "註冊";
}

<section class="col-12 col-md-6 col-lg-4 mx-auto">
    <h1 class="h3 mb-3">註冊</h1>

    <form method="post" asp-controller="Account" asp-action="Register">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

        <input type="hidden" asp-for="ReturnUrl" />
        <input type="hidden" asp-for="PendingAction" />

        <div class="mb-3">
            <label class="form-label" for="Email">Email</label>
            <input asp-for="Email" type="email" autocomplete="email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label class="form-label" for="Password">密碼（8～40 碼）</label>
            <input asp-for="Password" type="password" autocomplete="new-password" class="form-control" />
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label class="form-label" for="DisplayName">顯示名稱</label>
            <input asp-for="DisplayName" type="text" autocomplete="nickname" class="form-control" />
            <span asp-validation-for="DisplayName" class="text-danger small"></span>
        </div>

        <button class="btn btn-primary" type="submit">註冊</button>
    </form>

    <p class="mt-3 mb-0">
        已有帳號？<a asp-controller="Account" asp-action="Login"
                    asp-route-returnUrl="@Model.ReturnUrl" asp-route-pendingAction="@Model.PendingAction">登入</a>
    </p>
</section>
