@model Book_Finder.Models.ForgotPasswordForm
@{
    ViewData["Title"] = "忘記密碼";
}

<section class="col-12 col-md-6 col-lg-4 mx-auto">
    <h1 class="h3 mb-3">忘記密碼</h1>

    @if (ViewData["Notice"] is string notice)
    {
        <div class="alert alert-success py-2">@notice</div>
    }

    <p>請輸入註冊時的 Email，我們會寄出重設密碼的連結。</p>

    <form method="post" action="/account/password/forgot">
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <label class="form-label" for="Email">Email</label>
            <input asp-for="Email" type="email" autocomplete="email" class="form-control" />
        </div>

        <button class="btn btn-primary" type="submit">寄出重設密碼信</button>
    </form>

    <p class="mt-3 mb-0"><a href="/account/login">回到登入</a></p>
</section>
