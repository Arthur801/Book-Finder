<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 好想找書</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/onboarding.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/Book_Finder.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        // First-visit tour autostarts only on the public browse pages (plan §5.1). Account, OAuth, guide, AI and error pages never do.
        var routeController = ViewContext.RouteData.Values["controller"]?.ToString();
        var routeAction = ViewContext.RouteData.Values["action"]?.ToString();
        // A 404 keeps the route values but renders a NotFound view, so the view name is checked too.
        var isNotFoundView = ViewContext.View.Path.EndsWith("/NotFound.cshtml", StringComparison.Ordinal);
        var onboardingAutostart = !isNotFoundView && (routeController, routeAction) is ("Home", "Index") or ("Categories", "Index")
            or ("Search", "Index") or ("Books", "Index") or ("Books", "Detail");
    }
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom mb-3">
            <div class="container">
                <a class="navbar-brand fw-bold" href="/">好想找書</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-navbar" aria-controls="main-navbar"
                        aria-expanded="false" aria-label="切換導覽">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="main-navbar">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" href="/categories" data-tour="nav-categories">分類</a></li>
                        <li class="nav-item"><a class="nav-link" href="/ai" data-tour="nav-ai">AI 推薦</a></li>
                    </ul>
                    @{ var signedIn = User.Identity?.IsAuthenticated == true; }
                    <ul class="navbar-nav">
                        <li class="nav-item dropdown">
                            <button type="button" class="nav-link dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" data-tour="nav-more">更多</button>
                            <ul class="dropdown-menu dropdown-menu-end" id="nav-more-menu">
                                @if (signedIn)
                                {
                                    <li><a class="dropdown-item" href="/account#library">個人書單</a></li>
                                }
                                <li><a class="dropdown-item" href="/mcp-guide">MCP 說明</a></li>
                                <li><a class="dropdown-item" href="/categories#guide">功能導覽</a></li>
                                @if (signedIn)
                                {
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form method="post" asp-controller="Account" asp-action="Logout">
                                            <button type="submit" class="dropdown-item">登出</button>
                                        </form>
                                    </li>
                                }
                            </ul>
                        </li>
                        @if (signedIn)
                        {
                            <li class="nav-item"><a class="nav-link" href="/account">@User.Identity?.Name</a></li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" href="/account/login">登入</a></li>
                            <li class="nav-item"><a class="nav-link" href="/account/register">註冊</a></li>
                        }
                    </ul>
                    <noscript>
                        <ul class="navbar-nav">
                            @if (signedIn)
                            {
                                <li class="nav-item"><a class="nav-link" href="/account#library">個人書單</a></li>
                            }
                            <li class="nav-item"><a class="nav-link" href="/mcp-guide">MCP 說明</a></li>
                            @if (signedIn)
                            {
                                <li class="nav-item">
                                    <form method="post" asp-controller="Account" asp-action="Logout">
                                        <button type="submit" class="btn btn-link nav-link">登出</button>
                                    </form>
                                </li>
                            }
                        </ul>
                    </noscript>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["Notice"] is string notice)
            {
                <div class="alert alert-success mt-3" role="status">@notice</div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - 好想找書
        </div>
    </footer>
    <partial name="_Onboarding" model="onboardingAutostart" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/onboarding.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
