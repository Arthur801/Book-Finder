@model Book_Finder.Models.SearchResultsViewModel
@{
    ViewData["Title"] = "搜尋結果";
}

<section class="mb-2">
    <h1 class="h3 mb-3">搜尋結果</h1>
    <partial name="_SearchForm" model="Model.Query" />
</section>

@if (Model.SummaryText is { } summary)
{
    <p class="text-muted small mb-2">@summary</p>
}

@if (Model.HasItems)
{
    <ol class="list-unstyled search-results mb-0">
        @foreach (var item in Model.Items)
        {
            <li class="search-result d-flex align-items-center gap-3 py-2 border-bottom">
                @if (item.ThumbnailUrl is not null)
                {
                    <img class="cover" src="@item.ThumbnailUrl" alt="" width="48" height="68" loading="lazy" style="object-fit: cover;" />
                }
                else
                {
                    <span class="cover cover-placeholder text-muted small" style="width: 48px;">無封面</span>
                }
                <div class="flex-grow-1">
                    <a class="book-title" href="/books/@item.BookId">@item.Title</a>
                    @if (!string.IsNullOrWhiteSpace(item.Authors))
                    {
                        <div class="authors text-muted small">@item.Authors</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(item.Publisher))
                    {
                        <div class="publisher text-muted small">@item.Publisher</div>
                    }
                    @if (!string.IsNullOrEmpty(item.PublishedDate))
                    {
                        <div class="published-date text-muted small">@item.PublishedDate</div>
                    }
                </div>
            </li>
        }
    </ol>
}
else
{
    <p class="text-muted">找不到符合的書</p>
}

@if (Model.TotalCount > 0)
{
    <nav aria-label="搜尋結果分頁" class="mt-4">
        <ul class="pagination flex-wrap">
            @if (Model.PreviousUrl is { } previousUrl)
            {
                <li class="page-item"><a class="page-link" href="@previousUrl">上一頁</a></li>
            }
            else
            {
                <li class="page-item disabled"><span class="page-link">上一頁</span></li>
            }

            @foreach (var link in Model.PageLinks)
            {
                if (link.Page is null)
                {
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                }
                else if (link.IsCurrent)
                {
                    <li class="page-item active" aria-current="page"><span class="page-link">@link.Page</span></li>
                }
                else
                {
                    <li class="page-item"><a class="page-link" href="@link.Url">@link.Page</a></li>
                }
            }

            @if (Model.NextUrl is { } nextUrl)
            {
                <li class="page-item"><a class="page-link" href="@nextUrl">下一頁</a></li>
            }
            else
            {
                <li class="page-item disabled"><span class="page-link">下一頁</span></li>
            }
        </ul>
    </nav>
}
