@model Book_Finder.Models.SearchResultsViewModel
@{
    ViewData["Title"] = "搜尋結果";
}

<section class="mb-2">
    <h1 class="h3 mb-3">搜尋結果</h1>
    <partial name="_SearchForm" model="Model.Query" />
</section>

@if (Model.SummaryText is { } summary)
{
    <p class="text-muted small mb-2">@summary</p>
}

@if (Model.HasItems)
{
    <ol class="list-unstyled search-results mb-0">
        @foreach (var item in Model.Items)
        {
            <li class="search-result d-flex align-items-center gap-3 py-2 border-bottom" data-book-id="@item.BookId">
                @if (item.ThumbnailUrl is not null)
                {
                    <img class="cover" src="@item.ThumbnailUrl" alt="" width="48" height="68" loading="lazy" style="object-fit: cover;" />
                }
                else
                {
                    <span class="cover cover-placeholder text-muted small" style="width: 48px;">無封面</span>
                }
                <div class="flex-grow-1">
                    <a class="book-title" href="/books/@item.BookId">@item.Title</a>
                    @if (item.Authors is not null)
                    {
                        <div class="authors text-muted small">@item.Authors</div>
                    }
                    @if (item.Publisher is not null)
                    {
                        <div class="publisher text-muted small">@item.Publisher</div>
                    }
                    @if (item.PublishedDate is not null)
                    {
                        <div class="published-date text-muted small">@item.PublishedDate</div>
                    }
                </div>
            </li>
        }
    </ol>
}
else
{
    <p class="text-muted">找不到符合的書</p>
}

@if (Model.TotalCount > 0)
{
    ViewData["PagerLabel"] = "搜尋結果分頁";
    <partial name="_Pager" model="Model.Pager" />
}
