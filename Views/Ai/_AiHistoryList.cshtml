@model Book_Finder.Models.AiHistoryListViewModel
@*
    The AI search history list (recommendation.md §12, ui-flow.md §3.4). /ai renders it below the form, and /ai/history-list returns
    it alone so ai.js can replace the whole section after a successful search. This partial is the only place the list markup lives.
*@

<section id="ai-history" class="mt-5" aria-labelledby="ai-history-heading">
    <h2 id="ai-history-heading" class="h5 mb-3">AI 搜尋紀錄</h2>

    @if (Model.HasItems)
    {
        <ol class="list-unstyled ai-history-list mb-0">
            @foreach (var item in Model.Items)
            {
                <li class="border-bottom">
                    <a class="ai-history-item d-block py-2 text-decoration-none" href="/ai/history/@item.SearchId">
                        <div class="ai-history-requirement" title="@item.RequirementText">@item.RequirementText</div>
                        <div class="d-flex gap-3 small text-muted">
                            <span class="ai-history-time">@item.CreatedAtText</span>
                            <span class="ai-history-count">@item.ResultCount 本</span>
                        </div>
                    </a>
                </li>
            }
        </ol>
    }
    else
    {
        <p class="text-muted">還沒有 AI 搜尋紀錄</p>
    }

    @if (Model.TotalCount > 0)
    {
        ViewData["PagerLabel"] = "AI 搜尋紀錄分頁";
        <partial name="_Pager" model="Model.Pager" />
    }
</section>
