# The build context is the repository; keep secrets, VCS data, build output and non-web projects out of it.
.git
**/bin
**/obj
.env
.env.*
.vscode
.venv
tests/
# Only the two crawler host files are shipped in the release directory; the rest of crawler/ stays out.
crawler/*
!crawler/deploy
crawler/deploy/*
!crawler/deploy/run-crawler.sh
!crawler/deploy/crawler.cron
Docs/
TestResults
.github
*.user
HANDOFF.md
**/node_modules
.ruff_cache
**/.pytest_cache
