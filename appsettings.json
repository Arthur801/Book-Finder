{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Embedding": {
    "Model": "text-embedding-3-small",
    "Interval": "00:10:00",
    "BatchSize": 100,
    "BackfillEnabled": true
  },
  "AiProfile": {
    "Enabled": true,
    "QueueCapacity": 1000
  },
  "Recommendation": {
    "ChatModel": "gpt-6-luna",
    "SimilarityThreshold": 0.45,
    "TopK": 30,
    "ResultLimit": 10,
    "RankingDescriptionLength": 500,
    "DailyLimit": 20
  }
}
