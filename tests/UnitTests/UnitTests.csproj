<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Book-Finder.csproj" />
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Shared/SimilarityVectors.cs" Link="Shared/SimilarityVectors.cs" />
    <Compile Include="../Shared/FakeEmbeddingGenerator.cs" Link="Shared/FakeEmbeddingGenerator.cs" />
    <Compile Include="../Shared/FakeRequirementParser.cs" Link="Shared/FakeRequirementParser.cs" />
    <Compile Include="../Shared/CallGate.cs" Link="Shared/CallGate.cs" />
    <Compile Include="../Shared/FakeRecommendationRanker.cs" Link="Shared/FakeRecommendationRanker.cs" />
    <Compile Include="../Shared/FakeBookProfileGenerator.cs" Link="Shared/FakeBookProfileGenerator.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../Fixtures/isbn-normalization.json" Link="Fixtures/isbn-normalization.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Fixtures/unicode-15.1/NormalizationTest-NFKC.txt" Link="Fixtures/unicode-15.1/NormalizationTest-NFKC.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
